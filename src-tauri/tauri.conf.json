{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "WoW Addon Manager",
	"version": "1.0.0",
	"identifier": "com.worrysprite.wowaddonmanager",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "WoW Addon Manager",
				"width": 1280,
				"height": 860,
				"minWidth": 960,
				"minHeight": 640
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ3MDM2MzVFQ0EzNkY4QzUKUldURitEYktYbU1EUitkUEp3a3c4K3dhU0k1VXE0dEcrMDFjUzNvQlVBQ1lSc0VRSW1rN2NOcy8K",
			"endpoints": [
				"https://github.com/worrysprite/WoWAddonManager/releases/latest/download/latest.json"
			],
			"windows": {
				"installMode": "passive"
			}
		}
	}
}
